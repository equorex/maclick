{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "maclick@dev",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "142.0"
    }
  },
  "name": "maclick",
  "version": "1.1.0",
  "description": "Record and replay user actions on web pages",
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab"
  ],

  "background": {
    "scripts": ["js/storage.js", "js/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content_script.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "maclick - Record & Replay"
  }
}
